<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Keystore-encrypted secrets cannot be restored on another
     device, so they are excluded; chats and settings are backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
